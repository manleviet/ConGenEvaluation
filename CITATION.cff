cff-version: 1.2.0
message: "If you use this software or its data, please cite the paper below."
title: "Constraint Acquisition of Configuration Knowledge Bases with Maximum Satisfiable Subsets — evaluation artifact"
abstract: >-
  Source code, data and result tables for the ConGen paper: constraint
  acquisition from feature models via maximum satisfiable subsets.
type: software
version: 1.0.0
date-released: 2026-09-05
authors:
  - family-names: "Le"
    given-names: "Viet-Man"
license: MIT
repository-code: "https://github.com/manleviet/ConGenEvaluation"
# No software DOI here on purpose: the paper is what should be cited, and
# preferred-citation below points at it. The Zenodo archive gets its own DOI at
# release time — cite the VERSION DOI there, never the concept DOI, so the
# citation names the code that produced these numbers rather than "whatever is
# newest". Zenodo is triggered by the GitHub release webhook, so the repository
# must be connected to Zenodo BEFORE the release is published; connect it after
# and that release is simply not archived, silently.
#
# date-released must match the tag date. If tagging slips past 2026-09-05,
# update it here first -- it has already expired once.
preferred-citation:
  type: article
  title: "Constraint Acquisition of Configuration Knowledge Bases with Maximum Satisfiable Subsets"
  authors:
    - family-names: "Le"
      given-names: "Viet-Man"
  year: 2026
